{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zynqart",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-15",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zynqart",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
}
